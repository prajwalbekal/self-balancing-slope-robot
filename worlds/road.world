<?xml version="1.0"?>
<sdf version="1.6">
  <world name="road">

    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ============================================================
         Straight road:  18 m long (to the Gazebo grid edge), 2.5 m wide
         Robot starts at (0,0) facing +X and drives to (18,0).
         All road markings are VISUAL ONLY — no collision.
         ============================================================ -->

    <!-- Road surface — dark grey tarmac -->
    <model name="road_surface">
      <static>true</static>
      <pose>9 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>18 2.5 0.004</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left kerb  (y = +1.35) — visual only -->
    <model name="kerb_left">
      <static>true</static>
      <pose>9 1.35 0.06 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>18.0 0.15 0.12</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right kerb  (y = -1.35) — visual only -->
    <model name="kerb_right">
      <static>true</static>
      <pose>9 -1.35 0.06 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>18.0 0.15 0.12</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Centre dashed line — 9 white dashes -->
    <model name="dash_1"><static>true</static><pose>1 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="dash_2"><static>true</static><pose>3 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="dash_3"><static>true</static><pose>5 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="dash_4"><static>true</static><pose>7 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="dash_5"><static>true</static><pose>9 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="dash_6"><static>true</static><pose>11 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="dash_7"><static>true</static><pose>13 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="dash_8"><static>true</static><pose>15 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>
    <model name="dash_9"><static>true</static><pose>17 0 0.005 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.8 0.08 0.002</size></box></geometry>
        <material><script><name>Gazebo/White</name></script></material></visual></link></model>

    <!-- START marker — red post at (0, 0) -->
    <model name="start_post">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.07</radius><length>1.0</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- START line — white stripe across the road at x=0.5 -->
    <model name="start_line">
      <static>true</static>
      <pose>0.5 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.12 2.5 0.002</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- END marker — blue post at (18, 0) -->
    <model name="end_post">
      <static>true</static>
      <pose>18 0 0.5 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.07</radius><length>1.0</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- END line — white stripe across the road at x=17.5 -->
    <model name="end_line">
      <static>true</static>
      <pose>17.5 0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.12 2.5 0.002</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
