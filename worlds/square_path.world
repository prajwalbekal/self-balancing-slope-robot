<?xml version="1.0"?>
<sdf version="1.6">
  <world name="square_path">

    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ============================================================
         Square path:  5 m × 5 m
           A (Red,    0, 0)  START  robot spawns here facing +X
           B (Yellow, 5, 0)
           C (Green,  5, 5)
           D (Blue,   0, 5)
         Route:  A → B → C → D → A
         All corner posts are VISUAL ONLY — no collision so the robot
         can start right next to the red post without being pushed.
         ============================================================ -->

    <!-- Corner A — START (Red) -->
    <model name="corner_A_red">
      <static>true</static>
      <pose>0 0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.06</radius><length>0.8</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corner B (Yellow) -->
    <model name="corner_B_yellow">
      <static>true</static>
      <pose>5 0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.06</radius><length>0.8</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Yellow</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corner C (Green) -->
    <model name="corner_C_green">
      <static>true</static>
      <pose>5 5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.06</radius><length>0.8</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Corner D (Blue) -->
    <model name="corner_D_blue">
      <static>true</static>
      <pose>0 5 0.4 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.06</radius><length>0.8</length></cylinder></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low kerb strips along each side — visual only, no collision -->

    <!-- South side  A→B  (y ≈ −0.15, x 0→5) -->
    <model name="kerb_south">
      <static>true</static>
      <pose>2.5 -0.15 0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>5.3 0.08 0.10</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- East side  B→C  (x ≈ 5.15, y 0→5) -->
    <model name="kerb_east">
      <static>true</static>
      <pose>5.15 2.5 0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.08 5.3 0.10</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- North side  C→D  (y ≈ 5.15, x 0→5) -->
    <model name="kerb_north">
      <static>true</static>
      <pose>2.5 5.15 0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>5.3 0.08 0.10</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- West side  D→A  (x ≈ −0.15, y 0→5) -->
    <model name="kerb_west">
      <static>true</static>
      <pose>-0.15 2.5 0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.08 5.3 0.10</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
